# OPTIONAL (docs/10): copy to .github/workflows/deploy.yml after you finish the manual deployment.
# Uses GitHub OIDC - no AWS access keys stored in GitHub.
name: deploy-backend
on:
  push:
    branches: [master]
    paths: ['backend/**', 'infra/task-definition.json']

permissions:
  id-token: write   # needed for OIDC
  contents: read

env:
  AWS_REGION: eu-central-1
  ECR_REPOSITORY: product-api
  ECS_CLUSTER: product-cluster
  ECS_SERVICE: product-api-service
  CONTAINER_NAME: product-api

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push image (tagged with the git SHA)
        id: build
        run: |
          IMAGE_URI="${{ steps.ecr.outputs.registry }}/${ECR_REPOSITORY}:${GITHUB_SHA}"
          docker build -t "$IMAGE_URI" backend
          docker push "$IMAGE_URI"
          echo "image=$IMAGE_URI" >> "$GITHUB_OUTPUT"

      - name: Render task definition
        env:
          ACCOUNT_ID: ${{ secrets.AWS_ACCOUNT_ID }}
          DB_HOST: ${{ secrets.DB_HOST }}
          DB_SECRET_ARN: ${{ secrets.DB_SECRET_ARN }}
          IMAGE_URI: ${{ steps.build.outputs.image }}
        run: bash scripts/render-task-def.sh

      - uses: aws-actions/amazon-ecs-deploy-task-definition@v2
        with:
          task-definition: infra/task-definition.rendered.json
          service: ${{ env.ECS_SERVICE }}
          cluster: ${{ env.ECS_CLUSTER }}
          wait-for-service-stability: true
