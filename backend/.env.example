# Copy to .env for local development (never commit .env)
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=productsdb
# Local dev: plain user/password. In AWS we use DB_SECRET_ARN instead (see docs/03).
DB_USER=root
DB_PASSWORD=localdevpassword
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:123456789012:secret:rds!db-xxxx
DB_SSL=false
DB_POOL_SIZE=10

AWS_REGION=eu-central-1

# Empty = same-origin "/images/<key>" (works with CloudFront and the Vite dev server)
IMAGE_BASE_URL=
# Only needed if the browser calls the API on a different origin
# CORS_ORIGIN=http://localhost:5173
